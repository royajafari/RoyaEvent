# این فایل رو کپی کن به .env و مقادیر واقعی رو پر کن. .env هرگز کامیت نمی‌شه.

# --- عمومی ---
ENVIRONMENT=development

# --- دیتابیس ---
SQLITE_PATH=./roya_event.db
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=royaevent_analytics

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (S3-compatible؛ کد فقط با minio-py صحبت می‌کنه، برای
# هر دو سناریوی زیر کار می‌کنه، چون هردو S3-compatible هستن) ---

# سناریو ۱ (پیش‌فرض dev محلی): MinIO خودمیزبان از infra/docker-compose.yml
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=royaevent
MINIO_SECRET_KEY=royaevent_secret
MINIO_BUCKET=royaevent-media
MINIO_SECURE=false

# سناریو ۲ (production/managed): ArvanCloud Object Storage — همین چهار متغیر
# رو با مقادیر واقعی از پنل آروان جایگزین کن (Access Key/Secret Key، نه اون
# کلید مربوط به کاربر sub-user که دسترسی bucket policy نداشت)
# MINIO_ENDPOINT=s3.ir-thr-at1.arvanstorage.ir
# MINIO_ACCESS_KEY=...
# MINIO_SECRET_KEY=...
# MINIO_BUCKET=royaevent
# MINIO_SECURE=true

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP (طبق docs/event_otp_email_sms_plan_fa.md) ---
OTP_LENGTH=6
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_MINUTE=1
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_DAY=20
OTP_IP_MAX_REQUESTS_PER_10_MINUTES=10

# --- Provider پیامک ---
SMS_PROVIDER=ippanel
IPPANEL_API_KEY=
KAVENEGAR_API_KEY=

# --- Provider ایمیل ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@royaevent.ir
BREVO_SENDER_NAME=رویا ایونت
RESEND_API_KEY=

# --- جستجوی محتوایی ---
CHROMA_PERSIST_DIR=./chroma_data
